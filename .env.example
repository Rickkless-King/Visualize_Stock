# Copy this file to .env and fill in your own keys (never commit .env)

# LLM API (DeepSeek / Qwen / OpenAI-compatible)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Market & Macro Data Sources
FINNHUB_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with your contact email
SEC_USER_AGENT=VisualizeStock/0.1 (your_email@example.com)
